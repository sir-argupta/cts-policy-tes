import redis
import datetime
import hashlib
import hmac

# Provided from your assumed role session (screenshot)
access_key = ""
secret_key = ""
session_token = ""
region = "us-east-1"  # Replace with your actual region
host = "your-redis-endpoint.cache.amazonaws.com"
port = 6379
user = "default"  # Usually "default" unless your Redis is configured differently

# Generate IAM auth token
def get_redis_iam_token(access_key, secret_key, session_token, region, host, user):
    method = 'GET'
    service = 'elasticache'
    now = datetime.datetime.utcnow()
    amz_date = now.strftime('%Y%m%dT%H%M%SZ')
    date_stamp = now.strftime('%Y%m%d')
    credential_scope = f'{date_stamp}/{region}/{service}/aws4_request'
    canonical_uri = '/'
    canonical_querystring = f'Action=connect&User={user}'
    canonical_headers = f'host:{host}\n'
    signed_headers = 'host'
    payload_hash = hashlib.sha256(''.encode('utf-8')).hexdigest()

    canonical_request = '\n'.join([
        method,
        canonical_uri,
        canonical_querystring,
        canonical_headers,
        signed_headers,
        payload_hash
    ])

    string_to_sign = '\n'.join([
        'AWS4-HMAC-SHA256',
        amz_date,
        credential_scope,
        hashlib.sha256(canonical_request.encode('utf-8')).hexdigest()
    ])

    def sign(key, msg):
        return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()

    k_date = sign(('AWS4' + secret_key).encode('utf-8'), date_stamp)
    k_region = sign(k_date, region)
    k_service = sign(k_region, service)
    k_signing = sign(k_service, 'aws4_request')

    signature = hmac.new(k_signing, string_to_sign.encode('utf-8'), hashlib.sha256).hexdigest()

    # Build token
    token = (
        f"{user}"
        f"?Action=connect&User={user}"
        f"&X-Amz-Algorithm=AWS4-HMAC-SHA256"
        f"&X-Amz-Credential={access_key}%2F{credential_scope}"
        f"&X-Amz-Date={amz_date}"
        f"&X-Amz-SignedHeaders={signed_headers}"
        f"&X-Amz-Signature={signature}"
        f"&X-Amz-Security-Token={session_token}"
    )

    return token

# Generate token
token = get_redis_iam_token(access_key, secret_key, session_token, region, host, user)

# Connect to Redis using the token
redis_client = redis.StrictRedis(
    host=host,
    port=port,
    password=token,
    ssl=True
)

# Example usage
try:
    redis_client.set("test-key", "hello from assumed role!")
    value = redis_client.get("test-key")
    print("Got:", value.decode())
except redis.exceptions.RedisError as e:
    print("Redis error:", e)
