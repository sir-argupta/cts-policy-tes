function flattenUpdatedFields(obj) {
  const paths = [];

  function recurse(current, parentKey = '') {
    for (const key in current) {
      if (!Object.prototype.hasOwnProperty.call(current, key)) continue;

      const value = current[key];

      const isPrimitive =
        value === null ||
        typeof value !== 'object' ||
        value instanceof Date;

      if (isPrimitive) {
        paths.push(key); // only collect field name, not full path
      } else if (typeof value === 'object' && Object.keys(value).length === 0) {
        paths.push(key); // empty object still considered updated
      } else {
        recurse(value, key);
      }
    }
  }

  recurse(obj);
  return paths;
}

export function updateInterval(updatedIntervalData) {
  const updatedWorkOrder = updatedIntervalData?.workOrder ?? {};
  const updatedFields = flattenUpdatedFields(updatedWorkOrder);

  return {
    data: {
      ...updatedIntervalData,
      updatedFields
    },
    type: actions.INTERVAL_SELECTED
  };
}
