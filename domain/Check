describe('saveInterval key deletion logic', () => {
  it('should delete key if not in updatedFields', async () => {
    const mockState = {
      selectedInterval: {
        workOrder: {
          totalCost: 100,
          totalPartCost: 200
        },
        updatedFields: ['totalPartCost']  // totalCost will be deleted
      },
      selectedOrg: {},
    };

    const getStateStub = sinon.stub().returns(mockState);
    const dispatchStub = sinon.stub();

    await sut.saveInterval()(dispatchStub, getStateStub);

    expect(mockState.selectedInterval.workOrder).to.not.have.property('totalCost');
    expect(mockState.selectedInterval.workOrder).to.have.property('totalPartCost');
  });

  it('should not delete key if in updatedFields', async () => {
    const mockState = {
      selectedInterval: {
        workOrder: {
          totalCost: 100
        },
        updatedFields: ['totalCost']
      },
      selectedOrg: {},
    };

    const getStateStub = sinon.stub().returns(mockState);
    const dispatchStub = sinon.stub();

    await sut.saveInterval()(dispatchStub, getStateStub);

    expect(mockState.selectedInterval.workOrder).to.have.property('totalCost');
  });
});
