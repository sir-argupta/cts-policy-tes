import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.ArgumentCaptor;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.web.util.ContentCachingResponseWrapper;

import java.io.IOException;
import java.io.PrintWriter;
import java.io.StringWriter;
import java.time.Instant;
import java.util.HashMap;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class ExceptionFilterTest {

    @InjectMocks
    private ExceptionFilter exceptionFilter;

    @Mock
    private HttpServletRequest request;

    @Mock
    private HttpServletResponse response;

    @Mock
    private FilterChain filterChain;

    private ObjectMapper objectMapper;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        objectMapper = new ObjectMapper();
    }

    @Test
    void testDoFilter_NormalResponse_NoModification() throws IOException, ServletException {
        ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);

        // Mock response with status 200 (Normal case)
        when(response.getStatus()).thenReturn(HttpStatus.OK.value());

        // Run filter
        exceptionFilter.doFilter(request, responseWrapper, filterChain);

        // Ensure the filter chain is called, and no modification happens
        verify(filterChain).doFilter(request, responseWrapper);
        assertEquals(HttpStatus.OK.value(), response.getStatus());
    }

    @Test
    void testDoFilter_ErrorResponseWithAboutBlank_ModifiesResponse() throws IOException, ServletException {
        ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);
        String jsonResponse = "{ \"type\":\"about:blank\", \"detail\":\"Invalid input\" }";
        
        // Mock response output stream
        StringWriter stringWriter = new StringWriter();
        PrintWriter writer = new PrintWriter(stringWriter);
        when(response.getWriter()).thenReturn(writer);
        
        // Mock response behavior
        when(response.getStatus()).thenReturn(HttpStatus.BAD_REQUEST.value());
        responseWrapper.getWriter().write(jsonResponse);
        
        // Run filter
        exceptionFilter.doFilter(request, responseWrapper, filterChain);
        
        // Capture modified response
        writer.flush();
        String modifiedResponse = stringWriter.toString();
        
        // Ensure modification happened
        assertTrue(modifiedResponse.contains("\"error\""));
        assertTrue(modifiedResponse.contains("\"timestamp\""));
        assertTrue(modifiedResponse.contains("\"path\""));
        assertTrue(modifiedResponse.contains("\"status\""));
    }


    @Test
    void testDoFilter_ErrorResponseWithoutAboutBlank_NoModification() throws IOException, ServletException {
        ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);
        String jsonResponse = "{ \"title\": \"Bad Request\", \"status\": 400, \"detail\": \"Some issue\" }";
        
        // Mock response output stream
        StringWriter stringWriter = new StringWriter();
        PrintWriter writer = new PrintWriter(stringWriter);
        when(response.getWriter()).thenReturn(writer);
        
        // Mock response behavior
        when(response.getStatus()).thenReturn(HttpStatus.BAD_REQUEST.value());
        responseWrapper.getWriter().write(jsonResponse);
        
        // Run filter
        exceptionFilter.doFilter(request, responseWrapper, filterChain);
        
        // Capture modified response
        writer.flush();
        String modifiedResponse = stringWriter.toString();
        
        // Ensure modification DID NOT happen
        assertFalse(modifiedResponse.contains("\"error\""));
    }


    @Test
    void testModifyErrorResponse_GeneratesCorrectJson() throws IOException {
        ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);
        StringWriter stringWriter = new StringWriter();
        PrintWriter writer = new PrintWriter(stringWriter);
        when(response.getWriter()).thenReturn(writer);

        // Mock request
        when(request.getRequestURI()).thenReturn("/test/endpoint");

        // Run `modifyErrorResponse`
        exceptionFilter.modifyErrorResponse(request, responseWrapper, "Custom error message");

        // Capture response
        writer.flush();
        String jsonResponse = stringWriter.toString();

        // Parse JSON response
        Map<String, Object> jsonMap = objectMapper.readValue(jsonResponse, HashMap.class);

        // Assertions
        assertEquals("Custom error message", jsonMap.get("error"));
        assertEquals("/test/endpoint", jsonMap.get("path"));
        assertNotNull(jsonMap.get("timestamp"));
        assertNotNull(jsonMap.get("status"));
    }


    @Test
    void testContainsAboutBlankType_ShouldReturnTrue() {
        String responseBody = "{ \"type\":\"about:blank\", \"detail\":\"Some error\" }";
        assertTrue(exceptionFilter.containsAboutBlankType(responseBody));
    }

    @Test
    void testContainsAboutBlankType_ShouldReturnFalse() {
        String responseBody = "{ \"title\": \"Error\", \"status\": 400 }";
        assertFalse(exceptionFilter.containsAboutBlankType(responseBody));
    }
