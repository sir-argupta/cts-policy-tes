import os
import pandas as pd
from dotenv import load_dotenv

from llama_index.llms.openai import OpenAI
from llama_index.core.agent import ReActAgent
from llama_index.core.tools import QueryEngineTool, ToolMetadata
from llama_index.core.memory import ChatMemoryBuffer
from llama_index.experimental.query_engine import PandasQueryEngine

from prompts import new_prompt, instruction_str, coffee_context, context
from note_engine import note_engine
from pdf import canada_engine
from coffee_scraper import coffee_scraper

import json

# === Setup ===
load_dotenv()

tool_llm = OpenAI(model="gpt-4o-mini-2024-07-18")
chat_llm = OpenAI(model="gpt-4o-mini-2024-07-18")
chat_memory = ChatMemoryBuffer.from_defaults(token_limit=4096)

# === Load tools ===
population_df = pd.read_csv(os.path.join("data", "population.csv"))
population_query_engine = PandasQueryEngine(df=population_df, verbose=True, instruction_str=instruction_str)
population_query_engine.update_prompts({"pandas_prompt": new_prompt})

coffee_scraper.scrape_nearby_coffee()
coffee_query_engine = coffee_scraper.get_query_engine()

tools = [
    note_engine,
    QueryEngineTool(
        query_engine=population_query_engine,
        metadata=ToolMetadata(name="population_data", description="World population and demographics")
    ),
    QueryEngineTool(
        query_engine=canada_engine,
        metadata=ToolMetadata(name="canada_data", description="Detailed information about Canada")
    ),
    QueryEngineTool(
        query_engine=coffee_query_engine,
        metadata=ToolMetadata(name="ottawa_coffee", description="Coffee shops near Ottawa gallery")
    ),
]

# === Chat agent: decides whether to rewrite or clarify ===
def chat_agent(prompt: str, memory: ChatMemoryBuffer) -> dict:
    memory.put("user", prompt)

    history = memory.get_all_messages()
    history_str = "\n".join([f"{m['role'].capitalize()}: {m['content']}" for m in history])

    system_prompt = (
        "You are an assistant that routes user prompts to a tool agent.\n"
        "Your job is to either:\n"
        "1. Rewrite the user's message into a complete instruction with all required information.\n"
        "2. If the prompt is vague or missing info (e.g., missing machine ID), ask a clarifying question.\n\n"
        "Reply with a JSON object in this format:\n"
        '{ "action": "rewrite", "message": "rewritten prompt" }\n'
        '{ "action": "ask_user", "message": "clarifying question" }\n\n'
        f"Conversation so far:\n{history_str}\n\n"
        f"User: {prompt}"
    )

    full_prompt = system_prompt

    try:
        raw = chat_llm.complete(full_prompt).strip()
        memory.put("assistant", raw)
        parsed = json.loads(raw)
        return parsed
    except Exception:
        return {"action": "ask_user", "message": "Could you please clarify what you mean?"}

# === Build tool agent ===
def build_tool_agent(agent_context: str) -> ReActAgent:
    return ReActAgent.from_tools(
        tools=tools,
        llm=tool_llm,
        verbose=True,
        context=agent_context
    )

# === Main Loop ===
if __name__ == "__main__":
    base_context = context + "\n" + coffee_context

    while (prompt := input("You: ")) != "q":
        chat_response = chat_agent(prompt, chat_memory)

        if chat_response["action"] == "ask_user":
            print(f"[Agent Clarification]: {chat_response['message']}")
            continue  # Don’t run tool agent

        rewritten_prompt = chat_response["message"]
        print(f"[→ Tool Agent Input]: {rewritten_prompt}")

        tool_agent = build_tool_agent(agent_context=base_context)

        try:
            result = tool_agent.query(rewritten_prompt)
            print(f"[Agent]: {result}")
            chat_memory.put("assistant", str(result))
        except Exception as e:
            print(f"[ERROR]: {e}")
