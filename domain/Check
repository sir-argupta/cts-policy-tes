it('should set selected org, selected theme and handle theme when showPHInView is false', () => {
  const selectedOrganizations = [{
    id: chance.natural(),
    ...chance.object()
  }];
  const organizationHierarchy = [chance.object()];
  const theme = {
    name: 'cf'
  };

  // Set session values directly in props to simulate PHInView false path
  givenProps.session = {
    ...givenProps.session,
    showPHInView: false,
    selectedOrganizations,
    organizationHierarchy,
    theme
  };

  renderComponent(givenProps, givenStoreProps);

  expect(selectedOrgDux.setSelectedOrg.calledOnceWithExactly(selectedOrganizations[0], organizationHierarchy)).to.be.true;
  expect(selectedOrgDux.setSelectedTheme.calledOnceWithExactly(theme)).to.be.true;
  expect(wrapper.find(ThemeProvider).props().theme).to.equal(Themes.JDGreen);
});
