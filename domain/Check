public void deleteItemsBeforeDate(String cutoffDateString) {
    LocalDate cutoffDate = LocalDate.parse(cutoffDateString);
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd");

    Map<String, AttributeValue> expressionValues = new HashMap<>();
    expressionValues.put(":error_prefix", AttributeValue.builder().s("Product").build());
    expressionValues.put(":error_prefix1", AttributeValue.builder().s("BMC API Response is empty").build());
    expressionValues.put(":error_prefix2", AttributeValue.builder().s("check eligibility api").build());
    expressionValues.put(":error_prefix3", AttributeValue.builder().s("Manual").build());

    Expression filterExpression = Expression.builder()
        .expression("contains(error_description, :error_prefix) OR " +
                    "contains(error_description, :error_prefix1) OR " +
                    "contains(error_description, :error_prefix2) OR " +
                    "contains(error_description, :error_prefix3)")
        .expressionValues(expressionValues)
        .build();

    ScanEnhancedRequest scanRequest = ScanEnhancedRequest.builder()
        .filterExpression(filterExpression)
        .build();

    List<AutoEnrollmentFailures> toDelete = new ArrayList<>();

    Iterator<Page<AutoEnrollmentFailures>> results = failuresTable.scan(scanRequest).iterator();
    while (results.hasNext()) {
        Page<AutoEnrollmentFailures> page = results.next();
        for (AutoEnrollmentFailures item : page.items()) {
            if (item.getCrtdTs() != null) {
                LocalDate recordDate = LocalDate.parse(item.getCrtdTs().substring(0, 10), formatter);
                if (recordDate.isBefore(cutoffDate)) {
                    toDelete.add(item);
                }
            }
        }
    }

    if (toDelete.isEmpty()) {
        logger.info("No items to delete.");
        return;
    }

    for (int i = 0; i < toDelete.size(); i += 25) {
        List<AutoEnrollmentFailures> batchItems = toDelete.subList(i, Math.min(i + 25, toDelete.size()));
        WriteBatch.Builder<AutoEnrollmentFailures> batchBuilder = WriteBatch.builder(AutoEnrollmentFailures.class)
            .mappedTableResource(failuresTable);

        for (AutoEnrollmentFailures item : batchItems) {
            if (item.getMachineId() != null) {
                batchBuilder.addDeleteItem(item);
                logger.info("Deleting item with machine_id: {}", item.getMachineId());
            } else {
                logger.warn("Skipping item due to missing machine_id: {}", item);
            }
        }

        BatchWriteItemEnhancedRequest batchRequest = BatchWriteItemEnhancedRequest.builder()
            .writeBatches(batchBuilder.build())
            .build();

        enhancedClient.batchWriteItem(batchRequest);
        logger.info("Deleted {} items", batchItems.size());
    }
}

public List<FailedPinInformation> fetchErrorData(String serviceName) {
    List<FailedPinInformation> errorDataList = new ArrayList<>();

    Map<String, AttributeValue> expressionValues = new HashMap<>();
    Expression filterExpression;

    if ("PilotA".equalsIgnoreCase(serviceName)) {
        expressionValues.put(":error_prefix", AttributeValue.builder().s("Product").build());

        filterExpression = Expression.builder()
            .expression("contains(error_description, :error_prefix)")
            .expressionValues(expressionValues)
            .build();
    } else {
        expressionValues.put(":error_prefix1", AttributeValue.builder().s("BMC API Response is empty").build());
        expressionValues.put(":error_prefix2", AttributeValue.builder().s("check eligibility api").build());
        expressionValues.put(":error_prefix3", AttributeValue.builder().s("Manual").build());

        filterExpression = Expression.builder()
            .expression("contains(error_description, :error_prefix1) OR " +
                        "contains(error_description, :error_prefix2) OR " +
                        "contains(error_description, :error_prefix3)")
            .expressionValues(expressionValues)
            .build();
    }

    ScanEnhancedRequest scanRequest = ScanEnhancedRequest.builder()
        .filterExpression(filterExpression)
        .build();

    Iterator<Page<AutoEnrollmentFailures>> results = failuresTable.scan(scanRequest).iterator();
    while (results.hasNext()) {
        Page<AutoEnrollmentFailures> page = results.next();
        for (AutoEnrollmentFailures item : page.items()) {
            FailedPinInformation info = new FailedPinInformation(
                Optional.ofNullable(item.getMachineId()).orElse(0),
                Optional.ofNullable(item.getBmc()).orElse(""),
                Optional.ofNullable(item.getMasterId()).orElse(0),
                Optional.ofNullable(item.getOrgId()).orElse(0),
                Optional.ofNullable(item.getSerialNumber()).orElse(""),
                Optional.ofNullable(item.getErrorDescription()).orElse("")
            );
            errorDataList.add(info);
        }
    }

    logger.info("Failed data retrieved successfully from DB.");
    return errorDataList;
}
