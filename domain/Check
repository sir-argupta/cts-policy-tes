@Test
public void shouldUpdateTaskDetailsIfCompletedWhenWorkOrderExists() {
    WorkOrderDTO workOrderDTO = new WorkOrderDTO();
    workOrderDTO.setId(WORK_ORDER_ID);

    Event event = new Event();
    event.setWorkOrder(new WorkOrder());
    event.getWorkOrder().setId(BigInteger.valueOf(WORK_ORDER_ID));

    WorkOrderTask existingTask = new WorkOrderTask();
    existingTask.setId(BigInteger.valueOf(1));
    existingTask.setStatus(ApplicationConstants.WORK_ORDER_TASK_STATUS_COMPLETED);
    existingTask.setUserId(123L);

    event.getWorkOrder().setWorkOrderTasks(Collections.singletonList(existingTask));

    WorkOrderTaskDTO newTaskDTO = new WorkOrderTaskDTO();
    newTaskDTO.setId(BigInteger.valueOf(1));
    workOrderDTO.setTasks(Collections.singletonList(newTaskDTO));

    when(workOrderRepository.getWorkOrderById(BigInteger.valueOf(WORK_ORDER_ID)))
            .thenReturn(Optional.of(event.getWorkOrder()));

    WorkOrderDTO result = workOrderService.updateTaskDetailsIfCompleted(workOrderDTO, event);

    assertEquals(ApplicationConstants.WORK_ORDER_TASK_STATUS_COMPLETED, result.getTasks().get(0).getStatus());
    assertEquals(123L, result.getTasks().get(0).getUserId());

    verify(workOrderRepository, times(1)).getWorkOrderById(BigInteger.valueOf(WORK_ORDER_ID));
}

@Test
public void shouldNotUpdateTaskDetailsIfWorkOrderNotFound() {
    WorkOrderDTO workOrderDTO = new WorkOrderDTO();
    workOrderDTO.setId(WORK_ORDER_ID);
    Event event = new Event();

    when(workOrderRepository.getWorkOrderById(BigInteger.valueOf(WORK_ORDER_ID)))
            .thenReturn(Optional.empty());

    WorkOrderDTO result = workOrderService.updateTaskDetailsIfCompleted(workOrderDTO, event);

    assertEquals(WORK_ORDER_ID, result.getId());
    verify(workOrderRepository, times(1)).getWorkOrderById(BigInteger.valueOf(WORK_ORDER_ID));
}

@Test
public void shouldNotUpdateTaskDetailsIfTaskStatusIsNotCompleted() {
    WorkOrderDTO workOrderDTO = new WorkOrderDTO();
    workOrderDTO.setId(WORK_ORDER_ID);

    Event event = new Event();
    event.setWorkOrder(new WorkOrder());
    event.getWorkOrder().setId(BigInteger.valueOf(WORK_ORDER_ID));

    WorkOrderTask existingTask = new WorkOrderTask();
    existingTask.setId(BigInteger.valueOf(1));
    existingTask.setStatus("IN_PROGRESS");

    event.getWorkOrder().setWorkOrderTasks(Collections.singletonList(existingTask));

    WorkOrderTaskDTO newTaskDTO = new WorkOrderTaskDTO();
    newTaskDTO.setId(BigInteger.valueOf(1));
    workOrderDTO.setTasks(Collections.singletonList(newTaskDTO));

    when(workOrderRepository.getWorkOrderById(BigInteger.valueOf(WORK_ORDER_ID)))
            .thenReturn(Optional.of(event.getWorkOrder()));

