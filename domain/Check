@Transactional
public WorkOrder updateTaskDetailsIfCompleted(WorkOrder workOrder) {
    Optional<WorkOrder> existingWorkOrderOpt = getWorkOrder(workOrder.getId().longValue());

    if (existingWorkOrderOpt.isPresent()) {
        WorkOrder existingWorkOrder = existingWorkOrderOpt.get();

        // Create a map of existing workOrderTasks by ID for easy lookup
        Map<BigInteger, WorkOrderTask> existingTaskMap = existingWorkOrder.getWorkOrderTasks()
            .stream()
            .collect(Collectors.toMap(WorkOrderTask::getId, task -> task));

        for (WorkOrderTask newTask : workOrder.getWorkOrderTasks()) {
            WorkOrderTask existingTask = existingTaskMap.get(newTask.getId());

            if (existingTask != null) {
                // Check if the existing task status is "COMPLETED"
                if ("COMPLETED".equalsIgnoreCase(existingTask.getTaskStatus())) {
                    LOGGER.info("Updating WorkOrderTask ID: {} as it is marked COMPLETED in existing WorkOrder", newTask.getId());
                    
                    // Update task status and other relevant fields from the existing WorkOrderTask
                    newTask.setTaskStatus(existingTask.getTaskStatus());
                    newTask.setCompletedTimeStamp(existingTask.getCompletedTimeStamp());
                    newTask.setTask(existingTask.getTask());
                    newTask.setUserId(existingTask.getUserId());
                } else {
                    LOGGER.info("No update required for WorkOrderTask ID: {} with status: {}", 
                                newTask.getId(), existingTask.getTaskStatus());
                }
            } else {
                LOGGER.warn("Skipping task with ID: {} as it doesn't exist in the database", newTask.getId());
            }
        }

        return workOrder;  // Return the updated new WorkOrder
    } else {
        LOGGER.warn("WorkOrder with ID {} not found", workOrder.getId());
        return workOrder;  // Return the new WorkOrder even if not found in DB
    }
}
