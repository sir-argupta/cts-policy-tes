from typing import Literal
import json
import re

class MaintenanceManagerRAG:
    def __init__(self, chat_llm):
        self.chat_llm = chat_llm
        self.chat_memory = []  # You likely already use ChatMemoryBuffer in your real version

    def classify_question(self, question: str) -> Literal["in-context", "out-of-context"]:
        """
        Classifies whether the user question is in-context (relevant to John Deere Machine domain)
        or out-of-context.
        """
        try:
            classification_prompt = (
                "You are a classification model for filtering questions. "
                "Classify the following question as either 'in-context' or 'out-of-context'.\n\n"
                "Context: You are an assistant for Maintenance Manager, created for answering questions "
                "about John Deere machines, service intervals, maintenance, diagnostics, etc.\n\n"
                f"Question: {question}\n"
                "Answer (return only one of the two options):"
            )

            result = self.chat_llm.complete(classification_prompt)
            text = getattr(result, "text", None) or getattr(result, "message", None) or str(result)
            if "in-context" in text.lower():
                return "in-context"
            return "out-of-context"
        except Exception as e:
            print(f"[ERROR] Classification failed: {e}")
            return "in-context"  # Fail-safe

    def query(self, question: str, cookie: str = None, org_id: str = None):
        if not cookie or not org_id:
            return {"error": "Missing cookie or org_id"}

        classification = self.classify_question(question)

        if classification == "out-of-context":
            return {
                "classification": "out-of-context",
                "message": "I'm Maintenance Manager Agent, built to help only with John Deere machine related queries."
            }

        # Proceed with your regular pipeline if in-context
        chat_response = self.chat_agent(question)  # This is your existing method

        return {
            "classification": classification,
            "answer": chat_response.get("message") if isinstance(chat_response, dict) else str(chat_response)
        }
