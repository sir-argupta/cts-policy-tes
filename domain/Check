@Test
void testModifyErrorResponse_GeneratesCorrectJson() throws IOException {
    ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);
    StringWriter stringWriter = new StringWriter();
    PrintWriter writer = new PrintWriter(stringWriter);

    // 🛠 Ensure response writer is properly mocked
    when(response.getWriter()).thenReturn(writer);
    when(request.getRequestURI()).thenReturn("/test/endpoint");

    // 🛠 Call modifyErrorResponse with a custom message
    exceptionFilter.modifyErrorResponse(request, responseWrapper, "Custom error message");

    // 🛠 Ensure the response is flushed so data is written
    writer.flush();

    // ✅ Capture and validate the response
    String jsonResponse = stringWriter.toString();
    assertFalse(jsonResponse.isEmpty(), "Response should not be empty");

    // ✅ Ensure JSON is properly formatted
    Map<String, Object> jsonMap = objectMapper.readValue(jsonResponse, HashMap.class);

    // ✅ Assertions to verify correctness
    assertEquals("Custom error message", jsonMap.get("error"));
    assertEquals("/test/endpoint", jsonMap.get("path"));
    assertNotNull(jsonMap.get("timestamp"));
    assertNotNull(jsonMap.get("status"));
}
