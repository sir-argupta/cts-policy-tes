public class SecretsCache {
    private static final ConcurrentHashMap<String, CachedSecret> cache = new ConcurrentHashMap<>();
    private static final long TTL = TimeUnit.MINUTES.toMillis(10); // cache for 10 mins

    public static String getSecret(String key, SecretsManagerClient client) {
        CachedSecret cached = cache.get(key);
        long now = System.currentTimeMillis();

        if (cached == null || (now - cached.timestamp) > TTL) {
            String secret = fetchSecretFromAWS(key, client);
            cache.put(key, new CachedSecret(secret, now));
            return secret;
        }

        return cached.secret;
    }

    private static String fetchSecretFromAWS(String key, SecretsManagerClient client) {
        GetSecretValueRequest request = GetSecretValueRequest.builder().secretId(key).build();
        GetSecretValueResponse response = client.getSecretValue(request);
        return response.secretString();
    }

    private static class CachedSecret {
        String secret;
        long timestamp;

        CachedSecret(String secret, long timestamp) {
            this.secret = secret;
            this.timestamp = timestamp;
        }
    }
}
