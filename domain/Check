function renderComponentWithoutPersistentHeader(props, storeProps) {
  wrapper = shallow(
    <Application {...props} store={getStoreStub(storeProps)} />
  ).dive().dive();

  if (wrapper.find('.render-app').exists()) {
    renderedElement = wrapper.find('.render-app').at(0);
    divElement = renderedElement.children().at(0);

    if (divElement && divElement.type() === ThemeProvider) {
      ThemeProviderElement = divElement;
      appRouterElement = ThemeProviderElement.children().at(0);
    }
  }
}
