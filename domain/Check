import { getInterval, saveIntervalToPlatform } from '../services/intervals';
import { getCurrencyCode, addCommentId } from '../utility/interval-helper';

function getValueByPath(obj, path) {
  return path.split('.').reduce((acc, key) => acc?.[key], obj);
}

export const actions = {
  INTERVAL_SELECTED: 'INTERVAL_SELECTED',
  INTERVAL_CLEARED: 'INTERVAL_CLEARED'
};

export const mountPoint = 'selectedInterval';

export const initialState = {
  isError: false,
  isLoading: true,
  intervalSaved: false,
  showSaveMessage: false,
  intervalCompleted: false,
  workOrder: {
    workOrderComments: [],
    workOrderCompletionRecord: {},
    workOrderTasks: []
  },
  updatedFields: []
};

// Called when completing the interval
export function completeInterval(adjustData) {
  return async (dispatch, getState) => {
    const state = getState();

    dispatch(updateInterval({
      workOrder: {
        completed: true,
        adjustedByHours: adjustData.adjustedByHours,
        adjustedEngineHourInterval: adjustData.adjustedEngineHourInterval,
        adjustType: adjustData.adjustType,
        workOrderCompletionRecord: {
          completedByUserId: state.session.id,
          completedByUserName: state.session.id,
          userFullName: state.session.fullName
        },
        currency: getCurrencyCode(state.selectedInterval, state.selectedOrg),
        currentEngineHours: !state.selectedInterval.workOrder.currentEngineHours &&
                            state.selectedInterval.workOrder.displayEngineHours
                              ? state.selectedMachine?.lastKnownEngineHours
                              : state.selectedInterval.workOrder.currentEngineHours
      }
    }));

    addCommentId(state);
    
    try {
      await dispatch(saveInterval());
      dispatch({
        data: {
          isLoading: false,
          showCompleteMessage: true,
          intervalCompleted: true,
        },
        type: actions.INTERVAL_SELECTED
      });
    } catch (err) {
      dispatch({
        data: {
          isError: true,
          isLoading: false,
          showCompleteMessage: false,
          intervalCompleted: true,
        },
        type: actions.INTERVAL_SELECTED
      });
    }
  };
}

// Save only modified fields
export function saveInterval() {
  return async (dispatch, getState) => {
    const state = getState();
    const { updatedFields, workOrder } = state.selectedInterval;
    const currencyCode = getCurrencyCode(state.selectedInterval, state.selectedOrg);

    addCommentId(state);
    workOrder.currency = currencyCode;

    const payloadToSend = updatedFields.reduce((acc, key) => {
      acc[key] = getValueByPath(workOrder, key);
      return acc;
    }, {});

    try {
      await saveIntervalToPlatform({ workOrder: payloadToSend });
      dispatch({
        data: {
          isLoading: false,
          showSaveMessage: true,
          intervalSaved: true,
          updatedFields: []
        },
        type: actions.INTERVAL_SELECTED
      });
    } catch (err) {
      dispatch({
        data: {
          isError: true,
          isLoading: false,
          showSaveMessage: false,
          intervalSaved: false
        },
        type: actions.INTERVAL_SELECTED
      });
    }
  };
}

// Reset state flags
export function resetSelectedIntervalStates() {
  return async (dispatch, getState) => {
    const state = getState();
    dispatch({
      data: {
        ...state.selectedInterval,
        isLoading: false,
        showSaveMessage: false,
        intervalSaved: false,
        updatedFields: []
      },
      type: actions.INTERVAL_SELECTED
    });
  };
}

// Mark fields as updated (tracked in updatedFields)
export function updateInterval(updatedIntervalData) {
  return {
    data: {
      ...updatedIntervalData,
      updatedFields: Object.keys(updatedIntervalData.workOrder || {})
    },
    type: actions.INTERVAL_SELECTED
  };
}

// Fetch selected interval and prepare Redux state
export function setSelectedInterval(planId, intervalId) {
  return async (dispatch, getState) => {
    if (!planId || !intervalId) return;

    dispatch({
      data: {
        id: intervalId,
        isLoading: true
      },
      type: actions.INTERVAL_SELECTED
    });

    try {
      const intervalDataObject = await getInterval(planId, intervalId);
      intervalDataObject.workOrder.workOrderComments.forEach((obj, index) => {
        obj.commentId = index + 1;
      });

      const state = getState();

      if (intervalDataObject.workOrder.hasOwnProperty('displayEngineHours')) {
        delete state.selectedInterval.workOrder.displayEngineHours;
      }
      if (intervalDataObject.workOrder.hasOwnProperty('currentEngineHours')) {
        delete state.selectedInterval.workOrder.currentEngineHours;
      }

      dispatch({
        data: {
          ...intervalDataObject,
          isLoading: false,
          showSaveMessage: state.selectedInterval.showSaveMessage,
          updatedFields: []
        },
        type: actions.INTERVAL_SELECTED
      });
    } catch (err) {
      dispatch({
        data: {
          isError: true,
          isLoading: false
        },
        type: actions.INTERVAL_SELECTED
      });
    }
  };
}

// Clear interval
export function clearSelectedInterval() {
  return {
    type: actions.INTERVAL_CLEARED
  };
}

// Reducer
export function reducer(state = initialState, action) {
  switch (action.type) {
    case actions.INTERVAL_SELECTED: {
      return {
        ...state,
        ...action.data,
        workOrder: {
          ...state.workOrder,
          ...action.data.workOrder,
          workOrderCompletionRecord: {
            ...state.workOrder?.workOrderCompletionRecord,
            ...action.data.workOrder?.workOrderCompletionRecord
          }
        }
      };
    }
    case actions.INTERVAL_CLEARED: {
      return initialState;
    }
    default:
      return state;
  }
}
